#!/usr/bin/env bash
# pr-rebase <num> — safely rebase a PR branch onto origin/main in an isolated
# worktree, regenerate artifacts, run all gates, audit for leaks, then push.
#
# Never mutates the shared clone checkout.  The dedicated worktree is always
# removed on exit (success or failure).
#
# Usage:
#   scripts/dev/pr-rebase 123
set -euo pipefail

REPO_ROOT="$(git -C "$(dirname "$0")" rev-parse --show-toplevel)"
if [[ $# -ne 1 ]] || [[ ! "$1" =~ ^[1-9][0-9]*$ ]]; then
    echo "usage: pr-rebase <pr-number>" >&2
    exit 1
fi

PR="$1"
TEMP_ROOT=$(mktemp -d "/tmp/pr-rebase-$PR.XXXXXX")
WORKTREE_PATH="$TEMP_ROOT/worktree"

cleanup() {
    if [[ -d "$WORKTREE_PATH" ]]; then
        git -C "$REPO_ROOT" worktree remove --force "$WORKTREE_PATH" 2>/dev/null || true
    fi
    rmdir "$TEMP_ROOT" 2>/dev/null || true
}
trap cleanup EXIT

# Resolve the PR head branch name.
PR_DATA=$(gh pr view "$PR" --json headRefName,headRefOid,headRepositoryOwner --jq \
    '[.headRefName, .headRefOid, .headRepositoryOwner.login] | @tsv')
IFS=$'\t' read -r BRANCH EXPECTED_HEAD HEAD_OWNER <<< "$PR_DATA"
REPO_OWNER=$(gh repo view --json owner --jq '.owner.login')
if [[ "$HEAD_OWNER" != "$REPO_OWNER" ]]; then
    echo "pr-rebase: fork pull requests are not supported" >&2
    exit 1
fi
echo "PR $PR → branch: $BRANCH"

# Fetch latest state.
git -C "$REPO_ROOT" fetch origin main "$BRANCH"

# Create isolated worktree on the PR branch.
git -C "$REPO_ROOT" worktree add --detach "$WORKTREE_PATH" "$EXPECTED_HEAD"
cd "$WORKTREE_PATH"

# Rebase onto origin/main.
echo ">>> git rebase origin/main"
git rebase origin/main \
    || { echo "REBASE FAILED — resolve conflicts, then re-run pr-rebase" >&2; exit 1; }

# Regenerate coverage ledger and TS API docs.
echo ">>> regenerate coverage ledger"
uv sync --quiet
python scripts/generate-command-coverage.py
pnpm install --no-frozen-lockfile
pnpm docs:typescript

if ! git diff --quiet; then
    while IFS= read -r changed_path; do
        case "$changed_path" in
            docs/reference/COMMAND-COVERAGE.md|docs/reference/command-coverage.json|docs/reference/api/typescript/generated/*)
                ;;
            *)
                echo "pr-rebase: regeneration changed an unexpected path" >&2
                exit 1
                ;;
        esac
    done < <(git diff --name-only)
    git add docs/reference/COMMAND-COVERAGE.md \
        docs/reference/command-coverage.json \
        docs/reference/api/typescript/generated
    git commit -m "docs: regenerate derived references after rebase"
fi

# Run the full gate suite.
echo ">>> run-all-gates"
scripts/dev/run-all-gates \
    || { echo "GATE FAILED — fix failures, then re-run pr-rebase" >&2; exit 1; }

# Confidentiality audit on every changed blob and commit message. Reading blobs
# directly includes binary content that a textual patch would encode or omit.
echo ">>> confidentiality-check on changed content"
CHANGED_LIST="$TEMP_ROOT/changed-files"
git diff --name-only -z --diff-filter=ACMR "origin/main...HEAD" > "$CHANGED_LIST" \
    || { echo "CONFIDENTIALITY AUDIT FAILED — could not enumerate changes" >&2; exit 1; }
while IFS= read -r -d '' changed_path; do
    git cat-file blob "HEAD:$changed_path" | scripts/dev/confidentiality-check \
        || { echo "CONFIDENTIAL LEAK in changed content — DO NOT PUSH; fix and re-verify" >&2; exit 1; }
done < "$CHANGED_LIST"
git log --format='%H%n%B' "origin/main..HEAD" | scripts/dev/confidentiality-check \
    || { echo "CONFIDENTIAL LEAK in commit messages — DO NOT PUSH; fix and re-verify" >&2; exit 1; }

# Push with lease to avoid overwriting concurrent updates.
echo ">>> git push --force-with-lease"
git push origin "HEAD:refs/heads/$BRANCH" \
    "--force-with-lease=refs/heads/$BRANCH:$EXPECTED_HEAD"

echo ""
echo "PR $PR rebased and pushed successfully."
