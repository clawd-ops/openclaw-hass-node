#!/usr/bin/env bash
# Assemble the central exact-head brief and launch one review subagent.
set -euo pipefail

REPO_ROOT="$(git -C "$(dirname "$0")" rev-parse --show-toplevel)"
TEMPLATE="$REPO_ROOT/scripts/dev/templates/codex-review-brief.md"
CHECKER="$REPO_ROOT/scripts/dev/confidentiality-check"
DEFAULT_MODEL_SLUG="openai/gpt-5.6-sol"

if [[ $# -lt 1 || $# -gt 2 ]] || [[ ! "$1" =~ ^[1-9][0-9]*$ ]]; then
    echo "usage: spawn-codex-review <pr-number> [narrowing-file]" >&2
    echo "  REVIEW_MODEL_SLUG=<provider/model> to target a variant" >&2
    echo "  (default: ${DEFAULT_MODEL_SLUG})" >&2
    exit 1
fi

PR="$1"
NARROWING_FILE="${2:-}"

# One value drives both the brief and the spawn, so the reviewer signs off with
# the slug it was actually run as. Overridable because reviews target different
# variants; deliberately not fixed in the template, or every reviewer would
# claim the same identity no matter what ran.
MODEL_SLUG="${REVIEW_MODEL_SLUG:-$DEFAULT_MODEL_SLUG}"
if [[ ! "$MODEL_SLUG" =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]]; then
    echo "spawn-codex-review: REVIEW_MODEL_SLUG must be a full provider/model slug" >&2
    exit 1
fi
if [[ ! -f "$TEMPLATE" ]]; then
    echo "spawn-codex-review: template not found" >&2
    exit 1
fi
if [[ -n "$NARROWING_FILE" && ! -f "$NARROWING_FILE" ]]; then
    echo "spawn-codex-review: narrowing file not found" >&2
    exit 1
fi

HEAD_SHA=$(gh pr view "$PR" --json headRefOid --jq '.headRefOid')
BASE_SHA=$(gh pr view "$PR" --json baseRefOid --jq '.baseRefOid')
NARROWING="(no additional narrowing)"
if [[ -n "$NARROWING_FILE" ]]; then
    NARROWING=$(<"$NARROWING_FILE")
fi

BRIEF=$(python3 - "$HEAD_SHA" "$BASE_SHA" "$PR" "$NARROWING" "$TEMPLATE" "$MODEL_SLUG" << 'PYEOF'
import sys
from pathlib import Path

head_sha, base_sha, pr, narrowing, template, model_slug = sys.argv[1:]
content = Path(template).read_text(encoding="utf-8")
content = content.replace("<PR>", pr)
content = content.replace("<HEAD_SHA>", head_sha)
content = content.replace("<BASE_SHA>", base_sha)
content = content.replace("<NARROWING>", narrowing)
content = content.replace("<MODEL_SLUG>", model_slug)
if "<MODEL_SLUG>" in content:  # pragma: no cover - defensive
    sys.exit("spawn-codex-review: MODEL_SLUG substitution failed")
sys.stdout.write(content)
PYEOF
)

printf '%s' "$BRIEF" | "$CHECKER"

LAUNCHER_AGENT="${OPENCLAW_REVIEW_LAUNCHER_AGENT:-clawd}"
SESSION_KEY="agent:${LAUNCHER_AGENT}:review-launch-${PR}-${HEAD_SHA:0:12}-$$"
TEMP_DIR=$(mktemp -d "/tmp/spawn-codex-review-${PR}.XXXXXX")
PROMPT_FILE="$TEMP_DIR/launcher-prompt.txt"
RESULT_FILE="$TEMP_DIR/launcher-result.json"
SESSIONS_FILE="$TEMP_DIR/sessions.json"
HISTORY_FILE="$TEMP_DIR/history.json"
ERROR_FILE="$TEMP_DIR/launcher-errors.txt"
cleanup() {
    rm -f "$PROMPT_FILE" "$RESULT_FILE" "$SESSIONS_FILE" "$HISTORY_FILE" "$ERROR_FILE"
    rmdir "$TEMP_DIR" 2>/dev/null || true
}
trap cleanup EXIT

{
    printf '%s\n' "Call sessions_spawn exactly once with runtime=\"subagent\", mode=\"run\", context=\"isolated\", model=\"${MODEL_SLUG}\", visible=true, and expectsCompletionMessage=true."
    printf '%s\n' 'Use the complete review brief below as the task. Do not perform the review yourself. Return only the accepted spawn receipt as compact JSON with no fence or commentary.'
    printf '\n%s\n' "$BRIEF"
} > "$PROMPT_FILE"
"$CHECKER" "$PROMPT_FILE"

if ! openclaw agent \
    --agent "$LAUNCHER_AGENT" \
    --session-key "$SESSION_KEY" \
    --model "$MODEL_SLUG" \
    --thinking low \
    --message-file "$PROMPT_FILE" \
    --json > "$RESULT_FILE" 2> "$ERROR_FILE"; then
    "$CHECKER" "$ERROR_FILE" || true
    echo "spawn-codex-review: launcher turn failed" >&2
    exit 1
fi
"$CHECKER" "$ERROR_FILE"
"$CHECKER" "$RESULT_FILE"

RECEIPT=$(python3 - "$RESULT_FILE" << 'PYEOF'
import json
import sys
from pathlib import Path

try:
    result = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
    terminal = result["result"]["meta"]["agentMeta"]["terminalReceipt"]
    if terminal.get("successfulToolNames") != ["sessions_spawn"]:
        raise ValueError
    payloads = result["result"]["payloads"]
    if len(payloads) != 1 or not isinstance(payloads[0].get("text"), str):
        raise ValueError
    receipt = json.loads(payloads[0]["text"])
    if receipt.get("status") != "accepted":
        raise ValueError
    if not all(isinstance(receipt.get(key), str) and receipt[key] for key in ("runId", "childSessionKey")):
        raise ValueError
except (KeyError, TypeError, ValueError, json.JSONDecodeError, OSError):
    print("spawn-codex-review: no single accepted sessions_spawn receipt", file=sys.stderr)
    raise SystemExit(1)
print(json.dumps(receipt, separators=(",", ":"), sort_keys=True))
PYEOF
) || exit 1

if ! openclaw sessions --all-agents --json --limit all > "$SESSIONS_FILE" 2> "$ERROR_FILE"; then
    "$CHECKER" "$ERROR_FILE" || true
    echo "spawn-codex-review: could not verify the child session" >&2
    exit 1
fi
"$CHECKER" "$ERROR_FILE"
python3 - "$SESSIONS_FILE" "$RECEIPT" << 'PYEOF'
import json
import sys
from pathlib import Path

try:
    sessions = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))["sessions"]
    receipt = json.loads(sys.argv[2])
    if not any(item.get("key") == receipt["childSessionKey"] for item in sessions):
        raise ValueError
except (KeyError, TypeError, ValueError, json.JSONDecodeError, OSError):
    print("spawn-codex-review: accepted child session was not found", file=sys.stderr)
    raise SystemExit(1)
PYEOF

HISTORY_PARAMS=$(python3 - "$RECEIPT" << 'PYEOF'
import json
import sys

receipt = json.loads(sys.argv[1])
print(json.dumps({
    "name": "sessions_history",
    "args": {
        "sessionKey": receipt["childSessionKey"],
        "limit": 100,
        "includeTools": False,
    },
}))
PYEOF
)
# Brief-delivery verification is best-effort on purpose. The spawn itself is
# already proven by the accepted receipt and the child-session lookup above;
# this step is extra assurance that the child received the exact brief. The
# history API is not reachable in every runtime, so an API failure must be
# reported as an API failure and must not masquerade as a content mismatch.
# Conflating the two is worse than skipping the check: it accuses the brief of
# being wrong when nothing was ever compared.
HISTORY_AVAILABLE=1
if ! openclaw gateway call tools.invoke --json --params "$HISTORY_PARAMS" \
    > "$HISTORY_FILE" 2> "$ERROR_FILE"; then
    "$CHECKER" "$ERROR_FILE" || true
    echo "spawn-codex-review: warning — history API call failed; brief delivery unverified" >&2
    HISTORY_AVAILABLE=0
fi
if [[ "$HISTORY_AVAILABLE" -eq 1 ]]; then
    "$CHECKER" "$ERROR_FILE"
    "$CHECKER" "$HISTORY_FILE"
    python3 - "$HISTORY_FILE" "$BRIEF" << 'PYEOF'
import json
import sys
from pathlib import Path

raw = Path(sys.argv[1]).read_text(encoding="utf-8")
brief = sys.argv[2]

try:
    history = json.loads(raw)
except (json.JSONDecodeError, OSError) as exc:
    print(f"spawn-codex-review: warning — history unreadable ({exc}); brief delivery unverified", file=sys.stderr)
    raise SystemExit(0)

if history.get("ok") is False:
    message = (history.get("error") or {}).get("message", "unknown error")
    print(f"spawn-codex-review: warning — history API error ({message}); brief delivery unverified", file=sys.stderr)
    raise SystemExit(0)

try:
    messages = history["output"]["details"]["messages"]
    user_content = next(item["content"] for item in messages if item.get("role") == "user")
except (KeyError, StopIteration, TypeError):
    print("spawn-codex-review: warning — no user message in history; brief delivery unverified", file=sys.stderr)
    raise SystemExit(0)

if not isinstance(user_content, str):
    print("spawn-codex-review: warning — history content is not text; brief delivery unverified", file=sys.stderr)
    raise SystemExit(0)

# Delivery may wrap the task in a runtime envelope, so require containment
# rather than exact suffix equality. A genuine mismatch is still fatal: the
# brief was compared and did not survive.
if brief not in user_content:
    print("spawn-codex-review: child task does not match the assembled brief", file=sys.stderr)
    raise SystemExit(1)
PYEOF
fi

printf '%s\n' "$RECEIPT" | "$CHECKER"
printf '%s\n' "$RECEIPT"
