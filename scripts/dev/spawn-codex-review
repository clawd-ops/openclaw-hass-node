#!/usr/bin/env bash
# Run one exact-head review and publish its parent-attributed result.
set -euo pipefail

REPO_ROOT="$(git -C "$(dirname "$0")" rev-parse --show-toplevel)"
TEMPLATE="$REPO_ROOT/scripts/dev/templates/codex-review-brief.md"
CHECKER="$REPO_ROOT/scripts/dev/confidentiality-check"
DEFAULT_MODEL_SLUG="openai/gpt-5.6-sol"
# Author the idempotency guard matches on; the account the wrapper posts as.
COMMENT_AUTHOR="${REVIEW_COMMENT_AUTHOR:-clawd-ops}"

if [[ $# -lt 1 || $# -gt 2 ]] || [[ ! "$1" =~ ^[1-9][0-9]*$ ]]; then
    echo "usage: spawn-codex-review <pr-number> [narrowing-file]" >&2
    echo "  REVIEW_MODEL_SLUG=<provider/model> to target a variant" >&2
    echo "  (default: ${DEFAULT_MODEL_SLUG})" >&2
    exit 1
fi

PR="$1"
NARROWING_FILE="${2:-}"

# The requested slug is only a routing hint. Attribution comes from the child
# session record after the review finishes.
MODEL_SLUG="${REVIEW_MODEL_SLUG:-$DEFAULT_MODEL_SLUG}"
if [[ ! "$MODEL_SLUG" =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]]; then
    echo "spawn-codex-review: REVIEW_MODEL_SLUG must be a full provider/model slug" >&2
    exit 1
fi
if [[ ! -f "$TEMPLATE" ]]; then
    echo "spawn-codex-review: template not found" >&2
    exit 1
fi

if [[ -n "$NARROWING_FILE" && ! -f "$NARROWING_FILE" ]]; then
    echo "spawn-codex-review: narrowing file not found" >&2
    exit 1
fi

# Resolve the repository from the script's own checkout, never the caller's cwd.
# This script is addressed by path, so it can be invoked from inside a different
# authenticated checkout; a cwd-resolved lookup would then read and publish
# against that other repository while the brief points reviewers at this one.
REPOSITORY=$(cd "$REPO_ROOT" && gh repo view --json nameWithOwner --jq '.nameWithOwner')
HEAD_SHA=$(gh pr view "$PR" --repo "$REPOSITORY" --json headRefOid --jq '.headRefOid')
BASE_SHA=$(gh pr view "$PR" --repo "$REPOSITORY" --json baseRefOid --jq '.baseRefOid')
NARROWING="(no additional narrowing)"
if [[ -n "$NARROWING_FILE" ]]; then
    NARROWING=$(<"$NARROWING_FILE")
fi

BRIEF=$(python3 - "$HEAD_SHA" "$BASE_SHA" "$PR" "$NARROWING" "$TEMPLATE" "$REPOSITORY" "$REPO_ROOT" << 'PYEOF'
import sys
import shlex
from pathlib import Path

head_sha, base_sha, pr, narrowing, template, repository, repo_root = sys.argv[1:]
content = Path(template).read_text(encoding="utf-8")
content = content.replace("<PR>", pr)
content = content.replace("<HEAD_SHA>", head_sha)
content = content.replace("<BASE_SHA>", base_sha)
content = content.replace("<NARROWING>", narrowing)
content = content.replace("<REPOSITORY>", repository)
content = content.replace("<REPOSITORY_ROOT>", shlex.quote(repo_root))
for placeholder in ("<REPOSITORY>", "<REPOSITORY_ROOT>"):
    if placeholder in content:  # pragma: no cover - defensive
        sys.exit(f"spawn-codex-review: {placeholder} substitution failed")
sys.stdout.write(content)
PYEOF
)

printf '%s' "$BRIEF" | "$CHECKER"

TEMP_DIR=$(mktemp -d "/tmp/spawn-codex-review-${PR}.XXXXXX")
RUN_NONCE="${TEMP_DIR##*.}"
LAUNCHER_AGENT="${OPENCLAW_REVIEW_LAUNCHER_AGENT:-clawd}"
SESSION_KEY="agent:${LAUNCHER_AGENT}:review-launch-${PR}-${HEAD_SHA:0:12}-${RUN_NONCE}"
REVIEW_LABEL="review-pr-${PR}-${HEAD_SHA:0:12}-${RUN_NONCE}"
PROMPT_FILE="$TEMP_DIR/launcher-prompt.txt"
RESULT_FILE="$TEMP_DIR/launcher-result.json"
SESSIONS_FILE="$TEMP_DIR/sessions.json"
EXPORT_RESULT_FILE="$TEMP_DIR/export-result.json"
REVIEW_FILE="$TEMP_DIR/review.txt"
COMMENT_FILE="$TEMP_DIR/comment.md"
POST_RESULT_FILE="$TEMP_DIR/post-result.json"
READBACK_FILE="$TEMP_DIR/readback.json"
ERROR_FILE="$TEMP_DIR/launcher-errors.txt"
cleanup() {
    rm -rf "$TEMP_DIR"
}
trap cleanup EXIT

{
    printf '%s\n' "Call sessions_spawn exactly once with runtime=\"subagent\", mode=\"run\", context=\"isolated\", model=\"${MODEL_SLUG}\", label=\"${REVIEW_LABEL}\", visible=true, and expectsCompletionMessage=true."
    printf '%s\n' 'Use the complete review brief below as the task. Do not perform the review yourself. Return only the accepted spawn receipt as compact JSON with no fence or commentary.'
    printf '\n%s\n' "$BRIEF"
} > "$PROMPT_FILE"
"$CHECKER" "$PROMPT_FILE"

if ! openclaw agent \
    --agent "$LAUNCHER_AGENT" \
    --session-key "$SESSION_KEY" \
    --model "$MODEL_SLUG" \
    --thinking low \
    --message-file "$PROMPT_FILE" \
    --json > "$RESULT_FILE" 2> "$ERROR_FILE"; then
    "$CHECKER" "$ERROR_FILE" || true
    echo "spawn-codex-review: launcher turn failed" >&2
    exit 1
fi
"$CHECKER" "$ERROR_FILE"
"$CHECKER" "$RESULT_FILE"

RECEIPT=$(python3 - "$RESULT_FILE" << 'PYEOF'
import json
import sys
from pathlib import Path

try:
    result = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
    payloads = result["result"]["payloads"]
    if len(payloads) != 1 or not isinstance(payloads[0].get("text"), str):
        raise ValueError
    payload_text = payloads[0]["text"]
    successful = result["result"]["meta"]["agentMeta"]["terminalReceipt"].get(
        "successfulToolNames"
    )
    if not isinstance(successful, list) or successful.count("sessions_spawn") != 1:
        raise ValueError
    receipt = json.loads(payload_text)
    if receipt.get("status") != "accepted":
        raise ValueError
    if not all(isinstance(receipt.get(key), str) and receipt[key] for key in ("runId", "childSessionKey")):
        raise ValueError
except (KeyError, TypeError, ValueError, json.JSONDecodeError, OSError):
    print("spawn-codex-review: no single accepted sessions_spawn receipt", file=sys.stderr)
    raise SystemExit(1)
print(json.dumps(receipt, separators=(",", ":"), sort_keys=True))
PYEOF
) || exit 1

CHILD_KEY=$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["childSessionKey"])' "$RECEIPT")
WAIT_TIMEOUT="${REVIEW_WAIT_TIMEOUT_SECONDS:-3600}"
if [[ ! "$WAIT_TIMEOUT" =~ ^[1-9][0-9]*$ ]]; then
    echo "spawn-codex-review: REVIEW_WAIT_TIMEOUT_SECONDS must be a positive integer" >&2
    exit 1
fi
DEADLINE=$((SECONDS + WAIT_TIMEOUT))
while true; do
    if ! openclaw sessions --all-agents --json --limit all > "$SESSIONS_FILE" 2> "$ERROR_FILE"; then
        "$CHECKER" "$ERROR_FILE" || true
        echo "spawn-codex-review: could not read child session state" >&2
        exit 1
    fi
    "$CHECKER" "$ERROR_FILE"
    CHILD_STATUS=$(python3 - "$SESSIONS_FILE" "$CHILD_KEY" << 'PYEOF'
import json
import sys
from pathlib import Path

try:
    sessions = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))["sessions"]
    match = next(item for item in sessions if item.get("key") == sys.argv[2])
    status = match.get("status")
    if not isinstance(status, str) or not status:
        raise ValueError
except (KeyError, StopIteration, TypeError, ValueError, json.JSONDecodeError, OSError):
    print("spawn-codex-review: accepted child session was not found", file=sys.stderr)
    raise SystemExit(1)
print(status)
PYEOF
    ) || exit 1
    case "$CHILD_STATUS" in
        done) break ;;
        failed|cancelled|error)
            echo "spawn-codex-review: child review ended with status $CHILD_STATUS" >&2
            exit 1
            ;;
    esac
    if (( SECONDS >= DEADLINE )); then
        echo "spawn-codex-review: timed out waiting for child review" >&2
        exit 1
    fi
    sleep 5
done

MODEL_SLUG=$("$REPO_ROOT/scripts/dev/resolve-reviewer-model.py" "$SESSIONS_FILE" "$CHILD_KEY")

EXPORT_NAME="review-result"
if ! openclaw sessions export-trajectory \
    --agent "$LAUNCHER_AGENT" \
    --session-key "$CHILD_KEY" \
    --workspace "$TEMP_DIR" \
    --output "$EXPORT_NAME" \
    --json > "$EXPORT_RESULT_FILE" 2> "$ERROR_FILE"; then
    "$CHECKER" "$ERROR_FILE" || true
    echo "spawn-codex-review: could not retrieve child review" >&2
    exit 1
fi
"$CHECKER" "$ERROR_FILE"
EVENTS_FILE="$TEMP_DIR/.openclaw/trajectory-exports/$EXPORT_NAME/events.jsonl"
python3 - "$EVENTS_FILE" "$REVIEW_FILE" "$BRIEF" << 'PYEOF'
import json
import re
import sys
from pathlib import Path

# Verify what the child was actually asked to do, not merely that a child
# exited cleanly. A launcher could spawn with a truncated brief, a stale head,
# or a different task entirely and still return a well-formed verdict; that
# verdict would then be published against a head it never examined. The
# exact assembled brief, which contains the pinned head, is checked against
# the child's initial task before its output is trusted.
def _message_text(message):
    """Flatten a message's content to text.

    `content` is a list of typed parts on some messages and a plain string on
    others, so indexing straight into parts crashes on the string form.
    """
    content = message.get("content")
    if isinstance(content, str):
        return content
    if not isinstance(content, list):
        return ""
    return "".join(
        part["text"]
        for part in content
        if isinstance(part, dict)
        and part.get("type") == "text"
        and isinstance(part.get("text"), str)
    )


expected_brief = sys.argv[3]

tasks = []
try:
    for line in Path(sys.argv[1]).read_text(encoding="utf-8").splitlines():
        event = json.loads(line)
        if event.get("type") != "user.message":
            continue
        message = event["data"]["message"]
        text = _message_text(message)
        if text:
            tasks.append(text)
except (KeyError, OSError, TypeError, ValueError, json.JSONDecodeError):
    pass

if not tasks:
    sys.exit("spawn-codex-review: child trajectory has no initial task to verify")
initial_task = tasks[0]
runtime_framed_task = re.fullmatch(
    r"\[Subagent Context\] You are running as a subagent \(depth [1-5]/5\)\.\n\n"
    r"\[Subagent Task\]\n\n" + re.escape(expected_brief),
    initial_task,
)
if initial_task != expected_brief and runtime_framed_task is None:
    sys.exit("spawn-codex-review: child task does not exactly match the assembled brief")

messages = []
try:
    for line in Path(sys.argv[1]).read_text(encoding="utf-8").splitlines():
        event = json.loads(line)
        if event.get("type") != "assistant.message":
            continue
        message = event["data"]["message"]
        if message.get("role") != "assistant" or not message.get("__openclaw", {}).get(
            "runTerminal"
        ):
            continue
        text = _message_text(message)
        if text:
            messages.append(text)
except (KeyError, OSError, TypeError, ValueError, json.JSONDecodeError):
    pass
if len(messages) != 1:
    sys.exit("spawn-codex-review: child returned no single terminal text reply")
review = messages[0].strip()
if review.splitlines()[0] not in {"APPROVE", "REQUEST CHANGES"}:
    sys.exit("spawn-codex-review: child review has no valid verdict")
if "Reviewer model:" in review:
    sys.exit("spawn-codex-review: child review contains forbidden attribution")
Path(sys.argv[2]).write_text(review, encoding="utf-8")
PYEOF

python3 - "$REVIEW_FILE" "$COMMENT_FILE" "$MODEL_SLUG" "$HEAD_SHA" "$BASE_SHA" << 'PYEOF'
import sys
from pathlib import Path

# The head SHA belongs in the body's single `Reviewed head:` line, so the
# attribution carries the model only. Repeating the SHA here would put it in a
# comment twice and make the freshness parse ambiguous.
review = Path(sys.argv[1]).read_text(encoding="utf-8")
head, base = sys.argv[4], sys.argv[5]

reviewed_head = f"Reviewed head: `{head}` (base `{base}`)"
lines = review.splitlines()
if len(lines) < 2 or lines[1] != reviewed_head:
    sys.exit(
        "spawn-codex-review: child review must state the reviewed head on its exact "
        "second line as Reviewed head: `<head>` (base `<base>`)"
    )
if review.count(head) != 1:
    sys.exit("spawn-codex-review: child review mentions the head SHA more than once")

attribution = f"Reviewer model: {sys.argv[3]}"
Path(sys.argv[2]).write_text(f"{review}\n\n{attribution}", encoding="utf-8")
PYEOF
"$CHECKER" "$COMMENT_FILE"

LIVE_REFS=$(gh pr view "$PR" --repo "$REPOSITORY" --json headRefOid,baseRefOid \
    --jq '[.headRefOid, .baseRefOid] | @tsv')
IFS=$'\t' read -r LIVE_HEAD LIVE_BASE <<< "$LIVE_REFS"
if [[ "$LIVE_HEAD" != "$HEAD_SHA" || "$LIVE_BASE" != "$BASE_SHA" ]]; then
    echo "spawn-codex-review: PR head or base moved; review not posted" >&2
    exit 1
fi

# Idempotency guard. Publishing is an outward-facing side effect with no undo
# short of deleting a comment, so it must be safe to run this wrapper twice for
# the same pinned head. Two invocations posted the same verdict 81 seconds apart
# on PR 306; there is no retry loop in this path, so the duplicate came from a
# second run rather than a retried request, and a guard keyed on the pinned head
# covers both causes. The check is by author plus the exact `Reviewed head:`
# line, because that pair is what makes a review unique.
PIN_LINE="Reviewed head: \`$HEAD_SHA\` (base \`$BASE_SHA\`)"
EXISTING_URL=$(gh api "repos/$REPOSITORY/issues/$PR/comments" --paginate \
    | jq -r --arg author "$COMMENT_AUTHOR" --arg pin "$PIN_LINE" \
        '.[] | select(.user.login == $author)
        | select([.body | split("\n")[] | select(. == $pin)] | length == 1)
        | .html_url' \
    | head -n 1)
if [[ -n "$EXISTING_URL" ]]; then
    echo "spawn-codex-review: review already published for this head; not posting again" >&2
    printf '%s\n' "$EXISTING_URL"
    exit 0
fi

# The existing-comment query is a network call. Recheck both immutable refs
# after it, immediately before the outward-facing mutation.
LIVE_REFS=$(gh pr view "$PR" --repo "$REPOSITORY" --json headRefOid,baseRefOid \
    --jq '[.headRefOid, .baseRefOid] | @tsv')
IFS=$'\t' read -r LIVE_HEAD LIVE_BASE <<< "$LIVE_REFS"
if [[ "$LIVE_HEAD" != "$HEAD_SHA" || "$LIVE_BASE" != "$BASE_SHA" ]]; then
    echo "spawn-codex-review: PR head or base moved; review not posted" >&2
    exit 1
fi

jq -n --rawfile body "$COMMENT_FILE" '{body:$body}' | \
    gh api --method POST "repos/$REPOSITORY/issues/$PR/comments" --input - > "$POST_RESULT_FILE"
"$CHECKER" "$POST_RESULT_FILE"
COMMENT_ID=$(jq -er '.id' "$POST_RESULT_FILE")
COMMENT_URL=$(jq -er '.html_url' "$POST_RESULT_FILE")
gh api "repos/$REPOSITORY/issues/comments/$COMMENT_ID" > "$READBACK_FILE"
"$CHECKER" "$READBACK_FILE"
jq -e --rawfile expected "$COMMENT_FILE" '.body == $expected' "$READBACK_FILE" >/dev/null || {
    echo "spawn-codex-review: posted review did not read back exactly" >&2
    exit 1
}

jq -n \
    --arg commentUrl "$COMMENT_URL" \
    --arg childSessionKey "$CHILD_KEY" \
    --arg reviewerModel "$MODEL_SLUG" \
    --arg headSha "$HEAD_SHA" \
    --arg baseSha "$BASE_SHA" \
    '{commentUrl:$commentUrl,childSessionKey:$childSessionKey,reviewerModel:$reviewerModel,headSha:$headSha,baseSha:$baseSha}'
