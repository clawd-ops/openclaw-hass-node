#!/usr/bin/env python3
"""Emit one confidentiality-checked JSON snapshot for a pull request."""

from __future__ import annotations

import json
import re
import subprocess
import sys
from datetime import datetime
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[2]
CHECKER = ROOT / "scripts" / "dev" / "confidentiality-check"
ATTRIBUTION = "Reviewer model: openai/gpt-5.6-sol"
VERDICTS = {"APPROVE", "REQUEST CHANGES"}
SHA_RE = re.compile(r"(?<![0-9a-f])[0-9a-f]{40}(?![0-9a-f])", re.IGNORECASE)


def gh_json(*args: str) -> Any:
    """Run one GitHub CLI query and decode its JSON response."""
    result = subprocess.run(["gh", *args], cwd=ROOT, capture_output=True, text=True, check=False)
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or "GitHub query failed")
    return json.loads(result.stdout)


def gh_pages(endpoint: str) -> list[Any]:
    """Fetch every page from one REST endpoint as decoded JSON."""
    result = subprocess.run(
        ["gh", "api", "--paginate", "--slurp", endpoint],
        cwd=ROOT,
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or "GitHub query failed")
    return json.loads(result.stdout)


def paged_items(endpoint: str) -> list[dict[str, Any]]:
    """Flatten list-valued REST pages into one item list."""
    return [item for page in gh_pages(endpoint) for item in page]


def extract_pinned_sha(body: str, fallback: str | None) -> str | None:
    """Extract the review's explicitly named head SHA when present."""
    patterns = (
        r"(?i)reviewed(?:\s+at)?\s+exact\s+head\s+[`*]*([0-9a-f]{40})",
        r"(?i)reviewed\s+head\s*:\s*[`*]*([0-9a-f]{40})",
        r"(?i)exact\s+head\s*:\s*[`*]*([0-9a-f]{40})",
        r"(?i)reviewed\s+by\s+codex\s+at\s+[`*]*([0-9a-f]{40})",
    )
    for pattern in patterns:
        match = re.search(pattern, body)
        if match:
            return match.group(1).lower()
    match = SHA_RE.search(body)
    return match.group(0).lower() if match else fallback


def timestamp(item: dict[str, Any]) -> datetime:
    """Return the creation or submission time used to order reviews."""
    raw = item.get("submitted_at") or item.get("created_at") or "1970-01-01T00:00:00Z"
    return datetime.fromisoformat(raw.replace("Z", "+00:00"))


def is_trusted_codex_review(item: dict[str, Any], trusted_login: str) -> bool:
    """Accept only owner-authored bodies with the exact review envelope."""
    if (item.get("user") or {}).get("login") != trusted_login:
        return False
    lines = [line.strip() for line in (item.get("body") or "").splitlines() if line.strip()]
    if len(lines) < 3 or lines[0] not in VERDICTS or lines[-1] != ATTRIBUTION:
        return False
    return extract_pinned_sha(item.get("body") or "", None) is not None


def main() -> int:
    """Validate arguments and emit the requested pull-request snapshot."""
    if len(sys.argv) != 2 or not re.fullmatch(r"[1-9][0-9]*", sys.argv[1]):
        print("usage: pr-state <pr-number>", file=sys.stderr)
        return 2
    pr = sys.argv[1]
    repository = gh_json("repo", "view", "--json", "nameWithOwner")["nameWithOwner"]
    trusted_login = repository.split("/", 1)[0]
    core = gh_json("api", f"repos/{repository}/pulls/{pr}")
    head_sha = core["head"]["sha"]
    check_pages = gh_pages(f"repos/{repository}/commits/{head_sha}/check-runs?per_page=100")
    checks = [
        {"name": item["name"], "conclusion": item.get("conclusion")}
        for page in check_pages
        for item in page["check_runs"]
    ]

    candidates: list[dict[str, Any]] = []
    for item in paged_items(f"repos/{repository}/issues/{pr}/comments?per_page=100"):
        if is_trusted_codex_review(item, trusted_login):
            candidates.append(item)
    for item in paged_items(f"repos/{repository}/pulls/{pr}/reviews?per_page=100"):
        if is_trusted_codex_review(item, trusted_login):
            candidates.append(item)

    latest = max(candidates, key=timestamp) if candidates else None
    verdict_head: str | None = None
    pinned_sha: str | None = None
    if latest is not None:
        body = latest.get("body") or ""
        checked = subprocess.run([str(CHECKER)], cwd=ROOT, input=body, text=True, check=False)
        if checked.returncode != 0:
            print("pr-state: confidentiality check failed; output suppressed", file=sys.stderr)
            return 1
        verdict_head = next((line.strip() for line in body.splitlines() if line.strip()), None)
        pinned_sha = extract_pinned_sha(body, latest.get("commit_id"))

    output = {
        "head_sha": head_sha,
        "base_sha": core["base"]["sha"],
        "mergeable_state": core["mergeable_state"],
        "checks": checks,
        "latest_codex_verdict_body_head": verdict_head,
        "latest_codex_pinned_sha": pinned_sha,
        "state": core["state"],
        "pinned_sha_matches_head": pinned_sha == head_sha,
    }
    rendered = json.dumps(output, indent=2, sort_keys=True)
    checked = subprocess.run([str(CHECKER)], cwd=ROOT, input=rendered, text=True, check=False)
    if checked.returncode != 0:
        print("pr-state: confidentiality check failed; output suppressed", file=sys.stderr)
        return 1
    print(rendered)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
