#!/usr/bin/env bash
# confidentiality-check — scan content for operator-defined sensitive terms.
#
# Usage:
#   confidentiality-check [FILE]
#   echo "some text" | confidentiality-check
#
# Exit codes:
#   0  — clean (no matches found)
#   1  — match found (or denylist unavailable / unreadable)
#
# The denylist file is never echoed. Matched lines are never echoed.
set -euo pipefail

DENYLIST_FILE="${OPENCLAW_CONFIDENTIALITY_DENYLIST_FILE:-$HOME/.openclaw/state/confidentiality-denylist.txt}"

if [[ $# -gt 1 ]]; then
    echo "usage: confidentiality-check [file]" >&2
    exit 1
fi

if [[ ! -f "$DENYLIST_FILE" ]]; then
    echo "confidentiality-check: denylist not found" >&2
    exit 1
fi

if [[ ! -r "$DENYLIST_FILE" ]]; then
    echo "confidentiality-check: denylist not readable" >&2
    exit 1
fi

DENYLIST_MODE=$(stat -c '%a' "$DENYLIST_FILE" 2>/dev/null) \
    || { echo "confidentiality-check: could not verify denylist permissions" >&2; exit 1; }
if [[ "$DENYLIST_MODE" != "600" ]]; then
    echo "confidentiality-check: denylist must have mode 600" >&2
    exit 1
fi

if [[ ! -s "$DENYLIST_FILE" ]]; then
    # Empty denylist — nothing to match against, always clean.
    exit 0
fi

# grep -F uses fixed-string matching (no regex interpretation).
# grep exit codes: 0 = match found, 1 = no match, 2 = error. Capture the
# status explicitly so input errors fail closed instead of looking clean.
set +e
if [[ $# -eq 1 ]]; then
    grep -qiF -f "$DENYLIST_FILE" -- "$1" 2>/dev/null
else
    grep -qiF -f "$DENYLIST_FILE" 2>/dev/null
fi
status=$?
set -e
case "$status" in
    0)
        echo "CONFIDENTIAL LEAK — matches redacted from output" >&2
        exit 1
        ;;
    1)
        exit 0
        ;;
    *)
        echo "confidentiality-check: scan failed" >&2
        exit 1
        ;;
esac
