{
  "name": "@openclaw-hass-node/assist-tools",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "OpenClaw gateway plugin that bridges HA Assist sessions to the paired Home Assistant node command surface (ha_call_service, ha_get_state, ...).",
  "openclaw": {
    "extensions": ["./index.ts"],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2",
      "minGatewayVersion": "2026.3.24-beta.2"
    }
  },
  "dependencies": {
    "minimatch": "10.2.5",
    "typebox": "1.1.39"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.json",
    "docs:api": "typedoc --options typedoc.json && find ../../docs/reference/api/typescript/generated -type f -name '*.md' -exec sed -i 's/[[:space:]]\\+$//' {} +"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "5.9.2",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.13.0",
    "vitest": "3.0.5"
  }
}
